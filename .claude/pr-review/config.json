{
  "version": 1,
  "project": "doc-classifier",
  "visibility": "public",
  "securityChannel": "advisory",
  "workflowPath": ".github/workflows/pr-review.yml",
  "learnWorkflowPath": ".github/workflows/pr-review-learn.yml",
  "packages": ["src", "eval", "config"],
  "knowledge": ["checklist.md", "conventions.md", "false-positives.md", "contract-map.md", "learned-lessons.md"],
  "classes": [
    { "id": 1, "name": "Cross-repo contract drift with rag-system" },
    { "id": 2, "name": "Change applied to one transport only" },
    { "id": 3, "name": "Request fields reaching the filesystem or a URL unvalidated", "security": true },
    { "id": 4, "name": "Internal error detail returned to callers", "security": true },
    { "id": 5, "name": "Rationale or needsReview that hides an override" },
    { "id": 6, "name": "Committed configs, fixtures or golden set out of step with code" },
    { "id": 7, "name": "Consumer identity or domain content in a generic repo", "always": true },
    { "id": 8, "name": "Secrets, PII or document text in code, fixtures, logs or output", "security": true, "always": true, "light": true },
    { "id": 9, "name": "Fail-conservative regression", "security": true },
    { "id": 10, "name": "Tests that cannot fail" },
    { "id": 11, "name": "PR text or docs that claim what the code does not do", "always": true, "light": true },
    { "id": 12, "name": "NodeNext relative import without .js" }
  ],
  "tiers": { "enabled": false, "maxTurns": { "full": 30, "light": 10 } },
  "lightFiles": ["docs/**/*.md", "**/pnpm-lock.yaml"],
  "inline": { "max": 5, "severities": ["Critical", "High"] },
  "checks": {
    "piiLogs": { "fields": "documentText|text|ssn|dob|email|phone|address|token", "logCall": "\\b(?:console|(?:request|app)\\.log)\\." },
    "newFileSize": false,
    "titleScope": false,
    "selfEdit": true,
    "verifyDiff": false,
    "project": ["checks/doc-classifier.mjs"]
  },
  "trust": { "contextAssociations": ["OWNER"], "feedbackAuthors": ["marcusk639"] },
  "learning": { "distill": "model" }
}
